<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- hardware="mock": commanded positions are echoed back as the state, so
       MoveIt and RViz behave as if a perfect arm followed every trajectory.
       hardware="gazebo": gz_ros2_control/GazeboSimSystem drives the joints in
       Gazebo Harmonic (Gazebo Classic's gazebo_ros2_control/GazeboSystem does
       not exist there). Its controller manager runs inside Gazebo and loads
       config/ros2_controllers.yaml.
       A real-arm plugin (D1 JSON over DDS) would replace this block. -->
  <xacro:macro name="d1_joint" params="name initial">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">${initial}</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="d1_ros2_control" params="hardware:=mock end_effector:=gripper">
    <ros2_control name="D1System" type="system">
      <hardware>
        <xacro:if value="${hardware == 'gazebo'}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:unless value="${hardware == 'gazebo'}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:unless>
      </hardware>
      <xacro:d1_joint name="Joint1" initial="0.0"/>
      <xacro:d1_joint name="Joint2" initial="0.0"/>
      <xacro:d1_joint name="Joint3" initial="0.0"/>
      <xacro:d1_joint name="Joint4" initial="0.0"/>
      <xacro:d1_joint name="Joint5" initial="0.0"/>
      <xacro:d1_joint name="Joint6" initial="0.0"/>
      <xacro:if value="${end_effector == 'gripper'}">
        <xacro:d1_joint name="Joint_L" initial="0.0"/>
        <xacro:d1_joint name="Joint_R" initial="0.0"/>
      </xacro:if>
    </ros2_control>

    <xacro:if value="${hardware == 'gazebo'}">
      <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>$(find d1_moveit_config)/config/ros2_controllers.yaml</parameters>
        </plugin>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
