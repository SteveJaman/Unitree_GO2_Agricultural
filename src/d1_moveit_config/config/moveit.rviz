Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: moveit_rviz_plugin/MotionPlanningFrame
    Name: MotionPlanning
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 30
      Value: true
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Move Group Namespace: ""
      Robot Description: robot_description
      Planning Request:
        Planning Group: arm
        Interactive Marker Size: 0.15
      Planned Path:
        Loop Animation: false
        Show Trail: false
        State Display Time: 0.05 s
      Scene Geometry:
        Scene Alpha: 0.8
        Scene Color: 50; 160; 60
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Inspection views
      Enabled: true
      Topic:
        Value: /inspect_plant/markers
      Value: true
  Global Options:
    Background Color: 40; 42; 46
    Fixed Frame: world
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.8
      Focal Point: {X: 0.1, Y: -0.25, Z: 0.45}
      Pitch: 0.45
      Yaw: -0.9
Window Geometry:
  Width: 1400
  Height: 900
