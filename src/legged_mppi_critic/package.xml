<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>legged_mppi_critic</name>
  <version>0.1.0</version>
  <description>MPPI critic plugin that penalizes trajectories through traversability-marked costmap cells</description>
  <maintainer email="anthariel2001@gmail.com">Anthony Nguyen</maintainer>
