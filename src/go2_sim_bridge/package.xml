<?xml version="1.0"?>
<package format="3">
  <name>go2_sim_bridge</name>
  <version>0.1.0</version>
  <description>
    Adapts the CMU autonomy_stack_go2 Unity simulator to the go2-nav2-wifi
    topic/TF contract, so the same Nav2 config and frontier explorer that run
    on the real Go2 can be tested in simulation.
  </description>
  <maintainer email="rhimeshlwagun1@gmail.com">riderman10000</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- Nav2 stack under test (built from ~/files/go2-nav2-wifi) -->
  <exec_depend>go2_nav2</exec_depend>
  <exec_depend>go2_explore_panel</exec_depend>
  <!-- Simulator (built in ~/files/autonomy_stack_go2) -->
  <exec_depend>vehicle_simulator</exec_depend>
  <exec_depend>ros_tcp_endpoint</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
