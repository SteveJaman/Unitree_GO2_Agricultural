<?xml version="1.0"?>
<package format="3">
  <name>go2_vlm</name>
  <version>0.1.0</version>
  <description>
    Asks a vision-language model about the Go2 camera image and turns the
    answers into a Nav2 KeepoutFilter mask (planner routes around areas the
    VLM flags) and a Nav2 speed limit. It only adds cost; lidar obstacles are
    never lowered.
  </description>
  <maintainer email="rhimeshlwagun1@gmail.com">riderman10000</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
