# /etc/go2-realsense.env: settings for the go2-realsense boot service.
# Edit, then apply with:  sudo systemctl restart go2-realsense

# Workstation IP(s) the camera topics go to (CycloneDDS unicast peers).
# Space-separated for more than one. Update when the Ubuntu machine's DHCP address changes.
RS_DDS_PEERS=192.168.1.5

# Robot interface DDS binds to, and the DDS domain (never 0: Unitree's own).
RS_DDS_IFACE=wlan0
ROS_DOMAIN_ID=64

# Camera profiles "width,height,fps". 15 fps fits the current USB 2.1 link;
# use 640,480,30 once the node logs "Device USB type: 3.2".
RS_COLOR_PROFILE=640,480,15
RS_DEPTH_PROFILE=640,480,15
RS_ALIGN=true

# The hardware reset hangs on the USB 2.1 link: keep it off.
RS_INITIAL_RESET=false

# Docker image built from ~/files/rs-test.
RS_IMAGE=go2-realsense:foxy

# Seconds to wait at boot for the camera to enumerate and for the interface to get an IP.
# No camera after CAMERA_WAIT: the service exits cleanly and the node is not started.
CAMERA_WAIT=60
NET_WAIT=120
