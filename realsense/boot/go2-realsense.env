# /etc/go2-realsense.env: settings for the go2-realsense boot service.
# Edit, then apply with:  sudo systemctl restart go2-realsense

# The workstation(s) the camera topics go to, found by MAC so DHCP changes
# don't matter. Space-separated for more than one. Written by
#   ./scripts/tools/realsense_host.sh setup-robot   (the Wi-Fi MAC of that machine)
# Check on the workstation: cat /sys/class/net/<wifi iface>/address
RS_HOST_MAC=

# Optional fixed IPs, added to whatever the MAC lookup finds. Usually empty.
RS_DDS_PEERS=

# Robot interface DDS binds to, and the DDS domain (never 0: Unitree's own).
RS_DDS_IFACE=wlan0
ROS_DOMAIN_ID=64

# Camera profiles "width,height,fps". 15 fps fits the current USB 2.1 link;
# use 640,480,30 once the node logs "Device USB type: 3.2".
RS_COLOR_PROFILE=640,480,15
RS_DEPTH_PROFILE=640,480,15
RS_ALIGN=true

# The hardware reset hangs on the USB 2.1 link: keep it off.
RS_INITIAL_RESET=false

# Docker image on the robot.
RS_IMAGE=go2-realsense:foxy

# Boot waits (s): camera on USB (none -> node not started), Wi-Fi address, workstation.
CAMERA_WAIT=60
NET_WAIT=120
PEER_WAIT=45
# Seconds between re-checks of the workstation's IP (a change restarts the container).
RS_PEER_CHECK=20
