[Unit]
Description=RealSense D435i camera node (go2-realsense Docker container)
Documentation=file:///opt/go2-realsense/go2_realsense_boot.sh
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# Give up after 5 failed starts in 10 minutes (no restart loop if something is broken).
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/opt/go2-realsense/go2_realsense_boot.sh
ExecStop=/usr/bin/docker stop -t 10 go2-realsense
# Exit 0 (no camera, missing image) = stay stopped; a crash = restart after 15 s.
Restart=on-failure
RestartSec=15
TimeoutStartSec=infinity
TimeoutStopSec=30
# Low priority next to the Unitree stack.
Nice=5

[Install]
WantedBy=multi-user.target
