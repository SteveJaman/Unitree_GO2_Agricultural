<?xml version="1.0" encoding="UTF-8" ?>
<!--
  CycloneDDS configuration for direct Ethernet connection to the Go2 Jetson.

  Network:
    VM Ethernet adapter (enp0s8) : 192.168.123.100/24
    Go2 Jetson (eth0)            : 192.168.123.18/24
    Both are on the same subnet via a physical Ethernet cable.

  Why no relay is needed:
    The Go2 Jetson publishes /utlidar/cloud and /utlidar/imu natively
    over DDS on the internal Ethernet. Since this VM is on the same
    subnet, it receives those topics directly — no WebRTC, no SDK,
    no relay, no bridge.
-->
<CycloneDDS xmlns="https://cdds.io/config"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config
                                https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">

  <Domain id="any">

    <General>
      <Interfaces>
        <!--
          enp0s8 = VM's bridged Ethernet adapter connected to the Go2.
          If the VM gets a different adapter name, run:
              ip -o link show | awk -F': ' '{print $2}' | grep -v lo
          and update the name below.
        -->
        <NetworkInterface name="enp0s8"
                          priority="default"
                          multicast="default" />
      </Interfaces>

      <!--
        SPDP multicast for discovery. A direct Ethernet link handles
        multicast fine, so we don't need static peer entries.
      -->
      <AllowMulticast>spdp</AllowMulticast>
      <EnableMulticastLoopback>false</EnableMulticastLoopback>
    </General>

    <Discovery>
      <!-- Explicit peer: the Go2 Jetson on 192.168.123.0/24 -->
      <Peers>
        <Peer address="192.168.123.18"/>
      </Peers>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>500</MaxAutoParticipantIndex>
      <SPDPInterval>30s</SPDPInterval>
    </Discovery>

  </Domain>
</CycloneDDS>
