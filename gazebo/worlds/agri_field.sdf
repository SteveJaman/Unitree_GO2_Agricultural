<?xml version="1.0" ?>
<!--
  agri_field.sdf: a small walled field for the Go2 + D1 simulation.
  12 m x 8 m, three raised beds (0.6 m wide, 0.3 m tall) with plant rows,
  1.4 m aisles between beds, open headland at the west end where the robot
  spawns (x = -4.5, y = 0). Generated once; edit freely.
  @RENDER_ENGINE@ is substituted by start_inside.sh (ogre2 or ogre).
-->
<sdf version="1.9">
  <world name="agri_field">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>@RENDER_ENGINE@</render_engine>
    </plugin>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.95 1</background>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1.0</direction>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.45 0.38 0.28 1</ambient><diffuse>0.45 0.38 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="walls">
      <static>true</static>
      <link name="north">
        <pose>0 4.05 0.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>12.2 0.1 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.2 0.1 0.6</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
      <link name="south">
        <pose>0 -4.05 0.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>12.2 0.1 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.2 0.1 0.6</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
      <link name="east">
        <pose>6.05 0 0.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 8.0 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8.0 0.6</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
      <link name="west">
