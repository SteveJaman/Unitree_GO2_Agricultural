<?xml version="1.0" ?>
<!--
  traversability_test.sdf: minimal world for testing HeightBandLayer.
  Three boxes at known positions within the L1 lidar's forward FOV (~70 deg):
    - low_box:  0.10 m tall at (2.0,  0.0) — STEP_OVER (cost ~40)
    - med_box:  0.20 m tall at (2.5,  0.8) — CAUTION   (cost ~200)
    - tall_box: 0.30 m tall at (2.0, -0.8) — LETHAL    (cost 254)
  Robot spawns at (0, 0, 0) facing +x.
  @RENDER_ENGINE@ is substituted by start_inside.sh (ogre2 or ogre).
-->
<sdf version="1.9">
  <world name="traversability_test">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>@RENDER_ENGINE@</render_engine>
    </plugin>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.8 0.82 0.85 1</background>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.88 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1.0</direction>
    </light>

    <!-- Ground -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.62 0.62 0.60 1</ambient><diffuse>0.62 0.62 0.60 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Low box: 0.1 m tall (center at z=0.05), at x=2.0 y=0.0 -->
    <!-- STEP_OVER: ground_tolerance(0.02) <= h(0.1) < step_over_max(0.15) => cost 40 -->
    <model name="low_box">
      <static>true</static>
      <pose>2.0 0.0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.1</size></box></geometry>
          <material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Medium box: 0.2 m tall (center at z=0.10), at x=2.5 y=0.8 -->
    <!-- CAUTION: step_over_max(0.15) <= h(0.2) < lethal_min(0.25) => cost 200 -->
    <model name="medium_box">
      <static>true</static>
      <pose>2.5 0.8 0.10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.2</size></box></geometry>
          <material><ambient>0.8 0.8 0.2 1</ambient><diffuse>0.8 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tall box: 0.3 m tall (center at z=0.15), at x=2.0 y=-0.8 -->
    <!-- LETHAL: h(0.3) >= lethal_height_min(0.25) => cost 254 -->
    <model name="tall_box">
      <static>true</static>
      <pose>2.0 -0.8 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.3</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
