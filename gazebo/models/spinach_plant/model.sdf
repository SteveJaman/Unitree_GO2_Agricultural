<?xml version="1.0"?>
<sdf version="1.9">
  <model name="spinach_plant"><static>true</static>
    <link name="plant">
      <visual name="v"><geometry><mesh><uri>meshes/spinach.obj</uri></mesh></geometry></visual>
      <collision name="c"><pose>0 0 0.060 0 0 0</pose><geometry><cylinder><radius>0.126</radius><length>0.120</length></cylinder></geometry></collision>
    </link>
    <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>3</label></plugin>
  </model>
</sdf>
