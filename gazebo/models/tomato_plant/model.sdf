<?xml version="1.0"?>
<sdf version="1.9">
  <model name="tomato_plant"><static>true</static>
    <link name="plant">
      <visual name="v"><geometry><mesh><uri>meshes/tomato.obj</uri></mesh></geometry></visual>
      <collision name="c"><pose>0 0 0.301 0 0 0</pose><geometry><cylinder><radius>0.197</radius><length>0.601</length></cylinder></geometry></collision>
    </link>
    <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>4</label></plugin>
  </model>
</sdf>
