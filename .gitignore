# ROS 2 build artifacts
build/
install/
log/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# OneDrive noise
*.tmp

# Generated TF diagrams
frames_*.gv
frames_*.pdf

# Camera calibration runs (views, previews); the installed result is config/camera/front_camera.yaml
config/camera/runs/

# D1 arm plant-scan poses taught with scripts/tools/teach_arm.py (user data)
config/arm_waypoints.json

# Session data written by wifi_3d_nav.sh runs (this machine's maps and rooms)
config/home_map.json
config/semantic_rooms.json
config/survey_report.json
# Settings tab "save as my defaults" (each machine's own collision threshold / speed)
config/dashboard_settings.json

# Web app dependencies and build (the go2-3d image builds the dashboard itself)
twin/webapp/node_modules/
twin/webapp/dist/

# Arm offset calibration output (scripts/tools/calibrate_arm.py --output cal.json)
cal.json
