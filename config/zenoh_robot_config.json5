// zenoh_robot_config.json5
// Runs on the Go2 Jetson.
//
// Role: ZENOH ROUTER + ROS2DDS BRIDGE
//   - Bridges the Jetson's local CycloneDDS domain 0 to Zenoh
//   - Listens on TCP/7447 for the VM to connect
//   - Throttles high-rate topics so the Wi-Fi link isn't saturated
//
// Command to run on the Jetson:
//   zenoh-bridge-ros2dds -c zenoh_robot_config.json5
{
  // ---------------------------------------------------------------------
  // Zenoh router settings
  // ---------------------------------------------------------------------
  mode: "router",

  // Listen for incoming Zenoh connections from the VM
  listen: {
    endpoints: [
      "tcp/[::]:7447"   // all interfaces, IPv4 and IPv6
    ]
  },

  // Disable multicast scouting — we use explicit unicast
  scouting: {
    multicast: {
      enabled: false
    }
  },

  // ---------------------------------------------------------------------
  // ROS2DDS plugin — bridge between Zenoh and the local DDS domain
  // ---------------------------------------------------------------------
  plugins: {
    ros2dds: {
      // Names shown in the bridge's log lines
      nodename: "zenoh_bridge_robot",

      // DDS domain to bridge (must match the Jetson's ROS_DOMAIN_ID)
      domain: 0,

      // -----------------------------------------------------------------
      // Frequency throttling for high-rate topics.
      // Raw LiDAR is ~15 Hz and IMU is ~250 Hz. Over Wi-Fi these can
      // saturate the link. These caps keep the bridge healthy.
      // -----------------------------------------------------------------
      pub_max_frequencies: [
        ".*/utlidar/cloud=10",     // LiDAR capped at 10 Hz
        ".*/utlidar/imu=100",      // IMU capped at 100 Hz
        ".*/utlidar/.*=50",        // other utlidar topics at 50 Hz
      ],

      // -----------------------------------------------------------------
      // Topics to skip entirely (large, unused, or noisy)
      // -----------------------------------------------------------------
      pub_exclusions: [
        ".*/frontvideostream",     // raw H.264 — not needed
        ".*/videohub/.*",          // internal video plumbing
        ".*/audio.*",              // audio streams
        ".*/arm/.*",               // arm (Go2 has none)
      ],

      // -----------------------------------------------------------------
      // Control topics the VM sends back to the robot.
      // These come from Zenoh and are injected into the Jetson's DDS.
      // -----------------------------------------------------------------
      sub_exclusions: [],

      // -----------------------------------------------------------------
      // QoS bridging — forward the DDS QoS to Zenoh priority.
      // Sensors get lower priority than control.
      // -----------------------------------------------------------------
      ros2dds_queries_timeout: 5.0
    }
  }
}