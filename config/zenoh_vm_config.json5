// zenoh_vm_config.json5
// Runs on the VM.
//
// Role: ZENOH CLIENT + ROS2DDS BRIDGE
//   - Bridges the VM's local CycloneDDS domain 0 to Zenoh
//   - Connects outbound to the Jetson's router at 192.168.137.33:7447
//
// Command to run on the VM:
//   zenoh-bridge-ros2dds -c zenoh_vm_config.json5
{
  // ---------------------------------------------------------------------
  // Zenoh client settings
  // ---------------------------------------------------------------------
  mode: "client",

  // Connect to the Jetson's router
  connect: {
    endpoints: [
      "tcp/192.168.137.33:7447"   // <-- Go2 Jetson's Wi-Fi IP
    ],

    // Reconnect aggressively if the link drops
    retry: {
      period_init_ms: 1000,
      period_max_ms: 4000,
      period_increase_factor: 2
    }
  },

  // Disable multicast — we already know where the router is
  scouting: {
    multicast: {
      enabled: false
    }
  },

  // ---------------------------------------------------------------------
  // ROS2DDS plugin — bridge between Zenoh and the local DDS domain
  // ---------------------------------------------------------------------
  plugins: {
    ros2dds: {
      nodename: "zenoh_bridge_vm",

      // DDS domain on the VM (must match ROS_DOMAIN_ID)
      domain: 0,

      // -----------------------------------------------------------------
      // The VM only receives — no throttling needed.
      // If you also want to send /cmd_vel back to the robot, the
      // subscriber side picks it up automatically.
      // -----------------------------------------------------------------
      pub_max_frequencies: [],

      // Exclude the same high-bandwidth topics we don't need
      pub_exclusions: [
        ".*/frontvideostream",
        ".*/videohub/.*",
        ".*/audio.*",
      ],

      // -----------------------------------------------------------------
      // Subscribe exclusions — topics from Zenoh we do NOT want to
      // inject into the VM's local DDS.
      // -----------------------------------------------------------------
      sub_exclusions: []
    }
  }
}